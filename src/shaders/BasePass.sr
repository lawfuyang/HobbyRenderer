#include "Common.sr"
#include "Instance.sr"
#include "Mesh.sr"
#include "GPULight.sr"
#include "Cluster.sr"

cbuffer BasePassConstants
{
    PlanarViewConstants m_View;
    PlanarViewConstants m_PrevView;
    float4 m_FrustumPlanes[6];
    float4 m_CameraPos;
    float4 m_CullingCameraPos;
    uint m_LightCount;
    uint m_EnableRTShadows;
    uint m_DebugMode;
    uint m_EnableFrustumCulling;
    uint m_EnableConeCulling;
    uint m_EnableOcclusionCulling;
    uint m_HZBWidth;
    uint m_HZBHeight;
    float m_P00;
    float m_P11;
    float2 m_OpaqueColorDimensions;
    float3 m_SunDirection;
    uint m_EnableSky;
    uint m_OpaqueColorMipCount;
    int m_ForcedTextureMip;

    // Which list of cluster ids this draw writes into the visibility buffer, when the visibility path is on:
    // 0 = the opaque pass' own list, 1 = the two-pass culled list, 2 = the masked bucket. Unused by the raster path.
    uint m_VisListIndex;

    // The G-buffer's size, which the resolve turns a clip position into pixels with. The raster path has no use for
    // it and the resolve must not ask the texture, so it travels with the rest of the frame's view state.
    uint m_Width;
    uint m_Height;
};

srinput BasePassInputs
{
    BasePassConstants m_PerFrameCB;

    StructuredBuffer<PerInstanceData> Instances;         // t0
    StructuredBuffer<MaterialConstants> Materials;        // t1
    StructuredBuffer<VertexQuantized> Vertices;           // t2
    StructuredBuffer<MeshData> MeshData;                  // t3
    Texture2D<float> HZB;                                 // t8
    RaytracingAccelerationStructure SceneAS;               // t9
    StructuredBuffer<uint> Indices;                       // t10
    Texture2D<float4> OpaqueColor;                        // t11
    StructuredBuffer<GPULight> Lights;                    // t12

    // Cluster LOD: the cluster mesh shader reads the visible-cluster list the traversal wrote and resolves each
    // cluster's geometry through these.
    StructuredBuffer<ClusterJob>    ClusterJobs;          // t13
    StructuredBuffer<ClusterRecord> ClusterRecords;       // t14
    StructuredBuffer<uint>          ClusterStreamData;    // t15, the streaming arena: triangle and vertex words
    StructuredBuffer<ClusterGroup>  ClusterGroups;        // t16
    StructuredBuffer<ClusterGroupState> ClusterGroupStates; // t17, resolves a cluster's store through the group

    // The two-pass culled list, which the visibility ids' list 1 names. Only the resolve reads it: the revived
    // draw binds its list to ClusterJobs above.
    StructuredBuffer<ClusterJob>    ClusterJobsSecond;    // t19

    // The masked bucket's list, which the visibility ids' list 2 names. Same arrangement as ClusterJobsSecond.
    StructuredBuffer<ClusterJob>    ClusterJobsMasked;    // t20
};
