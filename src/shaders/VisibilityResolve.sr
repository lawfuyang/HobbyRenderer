// The visibility buffer the cluster buckets rasterised, one packed id per pixel (0 = no surface).
//
// Register space 1, because the pass also binds the base pass' own set at space 0: the resolve evaluates the same
// material code on the same bindings the raster path does, and the id buffer is the one thing it adds.
[space(1)]
srinput VisibilityResolveInputs
{
    Texture2D<uint> VisibilityBuffer;   // t0, space 1
};
