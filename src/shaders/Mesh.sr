struct Vertex
{
    float3 m_Pos;
    float3 m_Normal;
    float2 m_Uv;
    float4 m_Tangent;
};

struct VertexQuantized
{
    float3 m_Pos;
    uint   m_Normal;
    uint   m_Uv;
    uint   m_Tangent;
};

struct MeshData
{
    uint  m_LODCount;
    uint  m_IndexOffsets[8];
    uint  m_IndexCounts[8];
    float m_LODErrors[8];
};
