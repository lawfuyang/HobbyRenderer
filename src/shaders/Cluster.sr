#include "Common.sr"
#include "Instance.sr"
#include "Mesh.sr"

// Cluster LOD traversal data (docs/cluster-lod-implementation-plan.md §3.1).
//
// Phase 1 only carries what the traversal reads: the node tree, the group records and the per-geometry
// ranges. Geometry (micro indices, cluster-local vertex ranges) arrives in phase 2 with the cluster mesh
// shader, and materials in phase 3.
//
// The 8-bit cluster header of the reference is a packed uint here: srrhi (and HLSL) have no bitfields, and
// the traversal only needs the group ranges, which live in the group record.
// ── These records are also the cooked-mesh layout ────────────────────────────────────────────────────────
//
// ClusterLod aliases them (src/ClusterLod.h: Node, Bounds, TraversalMetric, Group) instead of declaring its own
// copies, and SceneCache writes them byte for byte into `<scene>_mesh.bin`. Changing a field of
// ClusterTraversalMetric, ClusterBounds, ClusterNode or ClusterGroup therefore changes the on-disk format:
// bump SceneCache::kCookedMeshVersion in the same commit, or an old cache will be read as the new layout.
// The records below that are traversal-only (jobs, queue entries, counters, per-geometry ranges) have no CPU
// copy and are free to change.
// 20 B. Everything the cut decision needs about a group. Cooked-mesh record (see the note above).
struct ClusterTraversalMetric
{
    float4 m_Sphere;             // xyz = centre, w = radius (inflated past the groups it replaces)
    float  m_MaxQuadricError;    // error of using this level instead of the original mesh
};

// 32 B. Culling bounds; the edge lengths drive cone/backface rejection in later phases. Cooked-mesh record.
struct ClusterBounds
{
    float3 m_Min;
    float  m_ShortestEdge;
    float3 m_Max;
    float  m_LongestEdge;
};

// 4 B. Bit 0 is the leaf flag: interior nodes carry (childOffset:26, childCount-1:5), leaves carry
// (groupIndex:23, groupClusterCount-1:8). Mirrors ClusterLod::Node, which packs and unpacks it.
// Cooked-mesh record.
struct ClusterNode
{
    uint m_Packed;
};

// 64 B. One per group: a contiguous run of clusters, the unit of the cut decision. Cooked-mesh record.
struct ClusterGroup
{
    uint                   m_ClusterOffset;  // global, see ClusterGeometry::m_ClusterOffset
    uint                   m_ClusterCount;
    uint                   m_LODLevel;
    ClusterTraversalMetric m_Metric;
    ClusterBounds          m_Bounds;
};

// 8 B. An entry of the visible-cluster list.
struct ClusterJob
{
    uint m_InstanceIndex;
    uint m_ClusterIndex;    // global, the geometry's cluster offset already added
};

// 8 B. An entry of the node traversal queue.
struct ClusterNodeRef
{
    uint m_InstanceIndex;
    uint m_NodeIndex;       // global node index
};

// 8 B. An entry of the group queue: a leaf the traversal kept and the culling pass still has to test.
struct ClusterGroupRef
{
    uint m_InstanceIndex;
    uint m_GroupIndex;      // global group index
};

// 32 B. One per MeshData: where this primitive's ranges start in the global arrays.
struct ClusterGeometry
{
    uint m_NodeOffset;
    uint m_NodeCount;
    uint m_GroupOffset;
    uint m_GroupCount;
    uint m_ClusterOffset;
    uint m_ClusterCount;
    uint m_LODLevelCount;
    uint m_MaxTreeDepth;
};

// 32 B, read back by the CPU for the counters panel and --cluster-stats-frame.
struct ClusterCounters
{
    uint m_InstanceCount;    // instances that passed the instance tests
    uint m_NodeCount;        // nodes visited
    uint m_GroupCount;       // groups queued by the node passes
    uint m_ClusterCount;     // clusters requested
    uint m_ClusterCapped;    // cluster requests dropped by the cap
    uint m_Pad0;
    uint m_Pad1;
    uint m_Pad2;
};

cbuffer ClusterTraversalConstants
{
    float4x4 m_View;
    float4   m_FrustumPlanes[6];
    float4   m_CameraPosition;   // xyz = world-space view position, the metric's distance origin

    uint  m_NumInstances;
    uint  m_InstanceBaseIndex;
    uint  m_EnableFrustumCulling;
    uint  m_EnableOcclusionCulling;

    uint  m_HZBWidth;
    uint  m_HZBHeight;
    uint  m_ForcedLOD;           // 0xFFFFFFFF = pick from the metric
    uint  m_MaxClusters;         // 0 = no cap

    float m_P00;
    float m_P11;
    float m_PixelErrorThreshold;
    float m_FocalPixels;

    uint  m_DisableCulling;
    uint  m_Pad0;
    uint  m_Pad1;
    uint  m_Pad2;
};

srinput ClusterTraversalInputs
{
    ClusterTraversalConstants m_TraversalCB;

    StructuredBuffer<PerInstanceData>  InstanceData;       // t0
    StructuredBuffer<ClusterGeometry>  Geometry;           // t1
    StructuredBuffer<ClusterNode>      Nodes;              // t2
    StructuredBuffer<ClusterBounds>    NodeBounds;         // t3
    StructuredBuffer<ClusterGroup>     Groups;             // t4
    StructuredBuffer<uint>             GeneratingGroups;   // t5, per cluster: coarser group that replaced it
    Texture2D<float>                   HZB;                // t6

    RWStructuredBuffer<ClusterNodeRef> NodeQueueIn;        // u0
    RWStructuredBuffer<ClusterNodeRef> NodeQueueOut;       // u1
    RWStructuredBuffer<uint>           NodeQueueCountIn;   // u2
    RWStructuredBuffer<uint>           NodeQueueCountOut;  // u3
    RWStructuredBuffer<ClusterGroupRef> GroupQueue;        // u4
    RWStructuredBuffer<uint>           GroupQueueCount;    // u5
    RWStructuredBuffer<ClusterJob>     ClusterJobs;        // u6
    RWStructuredBuffer<uint>           ClusterJobCount;    // u7
    RWStructuredBuffer<DispatchIndirectArguments> ClusterIndirectArgs; // u8
    RWStructuredBuffer<ClusterCounters> Counters;          // u9
};
