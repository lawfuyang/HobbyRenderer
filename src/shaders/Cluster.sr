#include "Common.sr"
#include "Instance.sr"
#include "Mesh.sr"

// Cluster LOD traversal data (docs/cluster-lod-implementation-plan.md §3.1).
//
// Phase 1 carried what the traversal reads: the node tree, the group records and the per-geometry ranges.
// Phase 2 adds what the mesh shader reads to draw a visible cluster: its own record and the two shared arrays
// its geometry lives in (packed micro indices, scene-wide vertex indices). Materials arrive in phase 3.
//
// The 8-bit cluster header of the reference is a packed uint here: srrhi (and HLSL) have no bitfields, and
// the traversal only needs the group ranges, which live in the group record.
// ── These records are also the cooked-mesh layout ────────────────────────────────────────────────────────
//
// ClusterLod aliases them (src/ClusterLod.h: Node, Bounds, TraversalMetric, Group) instead of declaring its own
// copies, and SceneCache writes them byte for byte into `<scene>_mesh.bin`. Changing a field of
// ClusterTraversalMetric, ClusterBounds, ClusterNode or ClusterGroup therefore changes the on-disk format:
// bump SceneCache::kCookedMeshVersion in the same commit, or an old cache will be read as the new layout.
// The records below that are traversal-only (jobs, queue entries, counters, per-geometry ranges) have no CPU
// copy and are free to change.
// 20 B. Everything the cut decision needs about a group. Cooked-mesh record (see the note above).
struct ClusterTraversalMetric
{
    float4 m_Sphere;             // xyz = centre, w = radius (inflated past the groups it replaces)
    float  m_MaxQuadricError;    // error of using this level instead of the original mesh
};

// 32 B. Culling bounds; the edge lengths drive cone/backface rejection in later phases. Cooked-mesh record.
struct ClusterBounds
{
    float3 m_Min;
    float  m_ShortestEdge;
    float3 m_Max;
    float  m_LongestEdge;
};

// 4 B. Bit 0 is the leaf flag: interior nodes carry (childOffset:26, childCount-1:5), leaves carry
// (groupIndex:23, groupClusterCount-1:8). Mirrors ClusterLod::Node, which packs and unpacks it.
// Cooked-mesh record.
struct ClusterNode
{
    uint m_Packed;
};

// 64 B. One per group: a contiguous run of clusters, the unit of the cut decision. Cooked-mesh record.
struct ClusterGroup
{
    uint                   m_ClusterOffset;  // global, see ClusterGeometry::m_ClusterOffset
    uint                   m_ClusterCount;
    uint                   m_LODLevel;
    ClusterTraversalMetric m_Metric;
    ClusterBounds          m_Bounds;
};

// 8 B. An entry of the visible-cluster list.
struct ClusterJob
{
    uint m_InstanceIndex;
    uint m_ClusterIndex;    // global, the geometry's cluster offset already added
};

// 32 B. The draw-side view of one cluster. ClusterLod::Cluster packs four 8-bit counts into one uint, which
// HLSL cannot read, so the mesh shader gets plain fields and element offsets into the two shared arrays
// below. Built at load from the cooked record (ClusterLodGpu.cpp), so this is not part of the cooked layout.
struct ClusterRecord
{
    uint m_TriangleCount;
    uint m_VertexCount;
    uint m_LODLevel;         // 0 = original mesh
    uint m_GroupIndex;       // global, for the culling bounds the debug view draws
    uint m_TriangleOffset;   // into ClusterTriangles, one packed micro-index triple per triangle
    uint m_VertexOffset;     // into ClusterVertices, one scene-wide vertex index per cluster vertex
    // The cluster's own bounding sphere, as halves: x, y in word 0 and z, radius in word 1. The traversal needs
    // it because a group's sphere bounds several clusters and is far too loose to reject the hidden ones.
    uint m_CenterRadius[2];
};

// 8 B. An entry of the node traversal queue.
struct ClusterNodeRef
{
    uint m_InstanceIndex;
    uint m_NodeIndex;       // global node index
};

// 8 B. An entry of the group queue: a leaf the traversal kept and the culling pass still has to test.
struct ClusterGroupRef
{
    uint m_InstanceIndex;
    uint m_GroupIndex;      // global group index
};

// 32 B. One per MeshData: where this primitive's ranges start in the global arrays.
struct ClusterGeometry
{
    uint m_NodeOffset;
    uint m_NodeCount;
    uint m_GroupOffset;
    uint m_GroupCount;
    uint m_ClusterOffset;
    uint m_ClusterCount;
    uint m_LODLevelCount;
    uint m_MaxTreeDepth;
};

// 32 B, read back by the CPU for the counters panel and --cluster-stats-frame.
struct ClusterCounters
{
    uint m_InstanceCount;    // instances that passed the instance tests
    uint m_NodeCount;        // nodes visited
    uint m_GroupCount;       // groups queued by the node passes
    uint m_ClusterCount;     // clusters requested by the first pass
    uint m_ClusterCapped;    // cluster requests dropped by the cap
    uint m_RejectNodeCount;  // nodes and instance roots the first pass rejected on occlusion
    uint m_RejectGroupCount; // groups the first pass rejected on occlusion
    uint m_RejectClusterCount;     // clusters the per-cluster occlusion test deferred
    uint m_SecondPassClusterCount;  // clusters the second pass revived
    uint m_CoarseClusterCount;      // drawn clusters that came from a level other than 0
};

// ── Geometry streaming ───────────────────────────────────────────────────────────────────────────────
//
// A group's triangle and vertex words live in one blob in a device arena (ClusterStreamData), and its
// address is looked up through ClusterGroupState. A group address below kClusterInvalidAddressStart is an
// element offset into that arena. At or above it the group is not resident, and the low bits carry the
// frame index of the last load request - which is how a second request for the same group in the same
// frame is suppressed without a second buffer (docs/cluster-lod-implementation-plan.md phase 5).

// A group address below kInvalidAddressStart is an element offset into the streaming arena; at or above it the
// group is not resident and the low bits carry the frame index of the last load request.
srinput ClusterStream
{
    static const uint kInvalidAddressStart = 2147483648u;   // 1 << 31
    static const uint kInvalidAddressMask = 2147483647u;    // (1 << 31) - 1
};

// 8 B. Per-group streaming state, indexed by global group index. Not part of the cooked-mesh layout: the
// host writes the initial state, the traversal requests missing groups and ages touched ones, StreamUpdate
// patches loads and unloads, and the age filter ages the rest.
struct ClusterGroupState
{
    uint m_Address;   // arena element offset, or kClusterInvalidAddressStart | last request frame
    uint m_Age;       // frames since the traversal last used this group
};

// 8 B. One address-table edit, applied by ClusterStreamUpdate. The first m_PatchUnloadCount entries of the
// list clear their group's address, the rest set it to m_Address.
struct ClusterStreamPatch
{
    uint m_GroupIndex;
    uint m_Address;
};

// 16 B, read back after the traversal: how many group requests this frame produced. The request lists
// themselves follow the counter in the same readback buffer.
struct ClusterStreamCounters
{
    uint m_LoadCount;
    uint m_UnloadCount;
    uint m_MaxLoads;      // set by the host before the frame
    uint m_MaxUnloads;
};

cbuffer ClusterTraversalConstants
{
    float4x4 m_View;
    float4   m_FrustumPlanes[6];
    float4   m_CameraPosition;   // xyz = world-space view position, the metric's distance origin

    uint  m_NumInstances;
    uint  m_InstanceBaseIndex;
    uint  m_EnableFrustumCulling;
    uint  m_EnableOcclusionCulling;

    uint  m_HZBWidth;
    uint  m_HZBHeight;
    uint  m_ForcedLOD;           // 0xFFFFFFFF = pick from the metric
    uint  m_MaxClusters;         // 0 = no cap

    float m_P00;
    float m_P11;
    float m_PixelErrorThreshold;
    float m_FocalPixels;

    uint  m_DisableCulling;
    uint  m_CullPass;            // 0 = builds the visible list, 1 = re-tests the reject lists against this frame's HZB
    uint  m_EnableRejectLists;   // 0 keeps the first pass' rejections on the floor, as it did before phase 4
    uint  m_StreamingEnabled;

    // Streaming: the frame index tags load requests (see ClusterGroupState::m_Address), and the budget caps
    // how many groups one frame can ask for.
    uint  m_FrameIndex;
    uint  m_MaxLoads;
    uint  m_Pad0;
    uint  m_Pad1;
};

srinput ClusterTraversalInputs
{
    ClusterTraversalConstants m_TraversalCB;

    StructuredBuffer<PerInstanceData>  InstanceData;       // t0
    StructuredBuffer<ClusterGeometry>  Geometry;           // t1
    StructuredBuffer<ClusterNode>      Nodes;              // t2
    StructuredBuffer<ClusterBounds>    NodeBounds;         // t3
    StructuredBuffer<ClusterGroup>     Groups;             // t4
    StructuredBuffer<uint>             GeneratingGroups;   // t5, per cluster: coarser group that replaced it
    StructuredBuffer<ClusterRecord>    ClusterRecords;    // t6, for the per-cluster bounding sphere
    Texture2D<float>                   HZB;                // t7

    RWStructuredBuffer<ClusterNodeRef> NodeQueueIn;        // u0
    RWStructuredBuffer<ClusterNodeRef> NodeQueueOut;       // u1
    RWStructuredBuffer<uint>           NodeQueueCountIn;   // u2
    RWStructuredBuffer<uint>           NodeQueueCountOut;  // u3
    RWStructuredBuffer<ClusterGroupRef> GroupQueue;        // u4
    RWStructuredBuffer<uint>           GroupQueueCount;    // u5
    RWStructuredBuffer<ClusterJob>     ClusterJobs;        // u6
    RWStructuredBuffer<uint>           ClusterJobCount;    // u7
    RWStructuredBuffer<DispatchIndirectArguments> ClusterIndirectArgs; // u8
    RWStructuredBuffer<ClusterCounters> Counters;          // u9
    // The reject lists (phase 4): what the first pass dropped on occlusion alone, so the second pass can
    // re-test it against the depth the first pass just wrote instead of traversing the tree again.
    RWStructuredBuffer<ClusterNodeRef>  RejectNodes;       // u10
    RWStructuredBuffer<uint>            RejectNodeCount;   // u11
    RWStructuredBuffer<ClusterGroupRef> RejectGroups;      // u12
    RWStructuredBuffer<uint>            RejectGroupCount;  // u13

    // The second pass appends into its own list, so the first pass' draw can still read its own.
    RWStructuredBuffer<ClusterJob>      ClusterJobsSecond;      // u14
    RWStructuredBuffer<uint>            ClusterJobCountSecond;  // u15

    // Per-cluster occlusion rejection: one bit per cluster, set by the first pass and read by the second, so a
    // group does not need a list of its own deferred clusters.
    RWStructuredBuffer<uint>           RejectClusterMasks;  // u16

    // The first pass' group queue, left intact for pass 1: its length is the grid the reject pass runs over.
    RWStructuredBuffer<ClusterGroupRef> Pass0Groups;        // u17
    RWStructuredBuffer<uint>            Pass0GroupCount;    // u18

    // Geometry streaming: the residency table the traversal reads and requests against, the list it appends
    // missing groups to, and the counters that list is read back by.
    RWStructuredBuffer<ClusterGroupState>     GroupStates;      // u19
    RWStructuredBuffer<uint>                  LoadRequests;     // u20
    RWStructuredBuffer<ClusterStreamCounters> StreamCounters;   // u21
};

// The patch pass (ClusterStreaming.hlsl). One thread per entry of the patch list; the host only writes the
// entries it actually decided this frame.
cbuffer ClusterStreamUpdateConstants
{
    uint m_PatchCount;
    uint m_PatchUnloadCount;   // entries [0, m_PatchUnloadCount) clear the address, the rest set it
    uint m_FrameIndex;
    uint m_Pad0;
};

srinput ClusterStreamUpdateInputs
{
    ClusterStreamUpdateConstants m_StreamCB;

    StructuredBuffer<ClusterStreamPatch>   Patches;      // t0
    RWStructuredBuffer<ClusterGroupState>  GroupStates;  // u0
};

// The age filter (ClusterStreaming.hlsl): one thread per resident group with a non-persistent address.
cbuffer ClusterStreamAgeConstants
{
    uint m_ActiveGroupCount;
    uint m_AgeThreshold;
    uint m_FrameIndex;
    uint m_MaxUnloads;
};

srinput ClusterStreamAgeInputs
{
    ClusterStreamAgeConstants m_StreamCB;

    StructuredBuffer<uint>                    ActiveGroups;     // t0
    RWStructuredBuffer<ClusterGroupState>     GroupStates;      // u0
    RWStructuredBuffer<uint>                  UnloadRequests;   // u1
    RWStructuredBuffer<ClusterStreamCounters> StreamCounters;   // u2
};
