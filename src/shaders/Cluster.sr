#include "Common.sr"
#include "Instance.sr"
#include "Mesh.sr"

// Cluster LOD traversal data (docs/cluster-lod-implementation-plan.md §3.1).
//
// Phase 1 only carries what the traversal reads: the node tree, the group records and the per-geometry
// ranges. Geometry (micro indices, cluster-local vertex ranges) arrives in phase 2 with the cluster mesh
// shader, and materials in phase 3.
//
// The 8-bit cluster header of the reference is a packed uint here: srrhi (and HLSL) have no bitfields, and
// the traversal only needs the group ranges, which live in the group record.

// 20 B. Everything the cut decision needs about a group.
struct ClusterTraversalMetric
{
    float4 m_Sphere;             // xyz = centre, w = radius (inflated past the groups it replaces)
    float  m_MaxQuadricError;    // error of using this level instead of the original mesh
};

// 32 B. Culling bounds; the edge lengths drive cone/backface rejection in later phases.
struct ClusterBounds
{
    float3 m_Min;
    float  m_ShortestEdge;
    float3 m_Max;
    float  m_LongestEdge;
};

// 4 B. Bit 0 is the leaf flag: interior nodes carry (childOffset:26, childCount-1:5), leaves carry
// (groupIndex:23, groupClusterCount-1:8). Mirrors ClusterLod::Node.
struct ClusterNode
{
    uint m_Packed;
};

// One per group. Groups own a contiguous run of clusters and are the unit of the cut decision.
struct ClusterGroup
{
    uint                   m_ClusterOffset;  // local to the geometry's cluster range
    uint                   m_ClusterCount;
    uint                   m_LODLevel;
    uint                   m_ReplaceGroup;   // coarser group that replaced this one, 0xFFFFFFFF = none
    ClusterTraversalMetric m_Metric;
    ClusterBounds          m_Bounds;
};

// 8 B. An entry of the visible-cluster list.
struct ClusterJob
{
    uint m_InstanceIndex;
    uint m_ClusterIndex;    // global, the geometry's cluster offset already added
};

// 8 B. An entry of the node traversal queue.
struct ClusterNodeRef
{
    uint m_InstanceIndex;
    uint m_NodeIndex;       // global node index
};

// 32 B. One per MeshData: where this primitive's ranges start in the global arrays.
struct ClusterGeometry
{
    uint m_NodeOffset;
    uint m_GroupOffset;
    uint m_ClusterOffset;
    uint m_LODLevelCount;
    uint m_MaxTreeDepth;
    uint m_Pad0;
    uint m_Pad1;
    uint m_Pad2;
};

// 32 B, read back by the CPU for the counters panel and --cluster-stats-frame.
struct ClusterCounters
{
    uint m_InstanceCount;    // instances that passed the instance tests
    uint m_NodeCount;        // nodes visited
    uint m_GroupCount;       // groups visited
    uint m_ClusterCount;     // clusters requested
    uint m_ClusterCapped;    // requests dropped by the cluster cap
    uint m_NodePassCount;    // traversal passes the run phase needed
    uint m_Pad0;
    uint m_Pad1;
};

cbuffer ClusterTraversalConstants
{
    float4x4 m_View;
    float4x4 m_ViewProj;
    float4   m_FrustumPlanes[6];

    uint  m_NumInstances;
    uint  m_InstanceBaseIndex;
    uint  m_EnableFrustumCulling;
    uint  m_EnableOcclusionCulling;

    uint  m_HZBWidth;
    uint  m_HZBHeight;
    uint  m_ForcedLOD;           // 0xFFFFFFFF = pick from the metric
    uint  m_MaxClusters;         // 0 = no cap

    float m_P00;
    float m_P11;
    float m_PixelErrorThreshold;
    float m_FocalPixels;

    uint  m_DisableCulling;
    uint  m_NodePass;            // which traversal pass this dispatch is
    uint  m_Pad0;
    uint  m_Pad1;
};

srinput ClusterTraversalInputs
{
    ClusterTraversalConstants m_TraversalCB;

    StructuredBuffer<PerInstanceData>  InstanceData;       // t0
    StructuredBuffer<MeshData>         MeshData;           // t1
    StructuredBuffer<ClusterGeometry>  Geometry;           // t2
    StructuredBuffer<ClusterNode>      Nodes;              // t3
    StructuredBuffer<ClusterBounds>    NodeBounds;         // t4
    StructuredBuffer<ClusterGroup>     Groups;             // t5
    Texture2D<float>                   HZB;                // t6

    RWStructuredBuffer<ClusterNodeRef> NodeQueueIn;        // u0
    RWStructuredBuffer<ClusterNodeRef> NodeQueueOut;       // u1
    RWStructuredBuffer<uint>           NodeQueueCountIn;   // u2
    RWStructuredBuffer<uint>           NodeQueueCountOut;  // u3
    RWStructuredBuffer<ClusterNodeRef> GroupQueue;         // u4
    RWStructuredBuffer<uint>           GroupQueueCount;    // u5
    RWStructuredBuffer<ClusterJob>     ClusterJobs;        // u6
    RWStructuredBuffer<uint>           ClusterJobCount;    // u7
    RWStructuredBuffer<DispatchIndirectArguments> NodeIndirectArgs;    // u8
    RWStructuredBuffer<DispatchIndirectArguments> ClusterIndirectArgs; // u9
    RWStructuredBuffer<ClusterCounters> Counters;          // u10
};
